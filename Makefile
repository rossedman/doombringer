.PHONY: check test lint lint-cpp lint-python lint-shell docs-audio fmt panel panel-check firmware vcv docs-serve docs-build clean

# Tracked and new (not ignored) sources. PanelLayout.hpp is generated by make_panel.py, so it is left alone.
CPP_FILES := $(filter-out vcv/src/PanelLayout.hpp,$(shell git ls-files --cached --others --exclude-standard 'dsp/*.hpp' 'hw/*.cpp' 'vcv/src/*.cpp' 'vcv/src/*.hpp' 'test/*.cpp' 'test/*.hpp'))
PY_FILES  := $(shell git ls-files --cached --others --exclude-standard '*.py')
SH_FILES  := $(shell git ls-files --cached --others --exclude-standard '*.sh')

# Pinned so local runs and CI use the same tools. Only uv (and clang-format) are needed.
CLANG_FORMAT ?= uvx --from clang-format==18.1.8 clang-format
RUFF         := uvx ruff@0.17.1
SHELLCHECK   := uvx --from shellcheck-py==0.11.0.1 shellcheck
SHFMT        := uvx --from shfmt-py==4.2.0 shfmt
PYTHON_TOOLS := uv run --no-project --with-requirements requirements-tools.txt
MKDOCS       := uv run --no-project --with-requirements requirements-docs.txt mkdocs
RACK_DIR     ?= ../Rack-SDK

# Everything CI runs that needs no cross-compiler or SDK.
check: lint test panel-check

# Host tests: responses, tracking, the macros, stability, renders. Fails on any failed check.
test:
	$(MAKE) -C test run

lint: lint-cpp lint-python lint-shell

lint-cpp:
	$(CLANG_FORMAT) --dry-run --Werror $(CPP_FILES)

lint-python:
	$(RUFF) check $(PY_FILES)
	$(RUFF) format --check $(PY_FILES)

lint-shell:
	$(SHELLCHECK) $(SH_FILES)
	$(SHFMT) -i 2 --diff $(SH_FILES)

fmt:
	$(CLANG_FORMAT) -i $(CPP_FILES)
	$(SHFMT) -i 2 --write $(SH_FILES)
	$(RUFF) check --fix $(PY_FILES)
	$(RUFF) format $(PY_FILES)

# Regenerate the panel SVG and the widget positions from the one table in make_panel.py.
panel:
	$(PYTHON_TOOLS) python vcv/res/make_panel.py

# Fail if the widget positions in PanelLayout.hpp have drifted from make_panel.py.
# (The SVG title outlines depend on the installed font, so only the header is compared.)
panel-check:
	@tmp=$$(mktemp -d) && mkdir -p $$tmp/res $$tmp/src && cp vcv/res/make_panel.py $$tmp/res/ && \
	$(PYTHON_TOOLS) python $$tmp/res/make_panel.py >/dev/null && \
	diff -u vcv/src/PanelLayout.hpp $$tmp/src/PanelLayout.hpp; rc=$$?; rm -rf $$tmp; exit $$rc

# patch.Init firmware. Needs arm-none-eabi-gcc on PATH and the libDaisy submodule.
firmware:
	$(MAKE) -C lib/libDaisy
	$(MAKE) -C hw

# VCV Rack 2 plugin. RACK_DIR points at an unpacked Rack SDK.
vcv:
	$(MAKE) -C vcv RACK_DIR=$(abspath $(RACK_DIR)) dist

# The listening page's audio: render the patches and the macro sweeps, then encode
# MP3s and spectrograms into docs/assets/audio (not committed; rebuilt each time).
docs-audio:
	$(MAKE) -C test renders
	$(PYTHON_TOOLS) python docs/assets/make_audio.py test/out/listen docs/assets/audio

# Docs site (MkDocs Material). docs-build is strict, so broken links and anchors fail it.
docs-serve: docs-audio
	$(MKDOCS) serve

docs-build: docs-audio
	$(MKDOCS) build --strict

clean:
	$(MAKE) -C test clean
	rm -rf hw/build vcv/build vcv/dist vcv/plugin.* site
